def main
    var b is byte
    var result is int

    def get_val is int: input as byte
        # Εδώ το byte 'input' προάγεται σε 'int' για την επιστροφή.
        # Παλιά υλοποίηση: χρησιμοποιεί SExt.
        # Νέα υλοποίηση: χρησιμοποιεί ZExt.
        return: input

    b := 200
    result := get_val(b)

    writeString: "Expected 200, got: "
    writeInteger: result
    writeString: "\n"

    if result < 0:
        writeString: "Bug: The unsigned byte became negative!\n"